<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>About Task</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-zinc-900 text-white">

    <main class="max-w-3xl mx-auto px-6 py-10">

        <nav class="flex items-center justify-between mb-14">

            <a
                href="/"
                class="text-sm text-zinc-400 hover:text-white transition"
            >
                ← Home
            </a>

            <a
                href="/file/edit/<%= title %>"
                class="text-sm text-zinc-400 hover:text-white transition"
            >
                Edit →
            </a>

        </nav>

        <header class="mb-8">

            <p class="text-xs font-medium uppercase tracking-[0.2em] text-zinc-500 mb-3">
                Task
            </p>

            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight break-words">
                <%= title %>
            </h1>

        </header>

        <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-sm">

            <p class="text-sm leading-7 text-zinc-300 whitespace-pre-wrap break-words">
                <%= data %>
            </p>

        </section>

    </main>

</body>

</html>