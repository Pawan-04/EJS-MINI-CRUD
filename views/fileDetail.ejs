<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Task</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-zinc-900 text-zinc-100">
    <main class="max-w-3xl mx-auto px-6 py-12">
    <a
        href="/"
        class="inline-flex items-center gap-1 text-sm text-zinc-400 hover:text-white transition"
    >
        ← Home
    </a>

    <header class="mt-10 mb-8">
        <p class="text-xs uppercase tracking-widest text-zinc-500 mb-2">Task</p>

        <h1 class="text-3xl font-semibold tracking-tight"><%= title %></h1>
    </header>

    <section class="border border-zinc-800 bg-zinc-900 rounded-xl p-6">
        <p class="text-zinc-300 leading-7"><%= data %></p>
    /section>
    </main>
</body>
</html>
