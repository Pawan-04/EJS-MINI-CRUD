
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 text-white min-h-screen">
    <div class="max-w-4xl mx-auto px-6 py-10">

        <h1 class="text-2xl font-semibold mb-6">
            <%= fileName %>
        </h1>

        <form class="flex gap-3 mb-10" action="/edit/<%= fileName %>"  method='post'>


            <textarea
                type="text"
                class="flex-1 bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-zinc-500"
                name="details"
            > <%= data %> </textarea>

            <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-500 px-5 py-3 rounded-lg font-medium transition"
            >
                Edit
            </button>

        </form>


        

    </div>

</body>
</html>
