
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 text-white min-h-screen">
    <div class="max-w-4xl mx-auto px-6 py-10">

        <h1 class="text-2xl font-semibold mb-6">
            My Tasks
        </h1>

        <form class="flex gap-3 mb-10" action="/create"  method="post">

            <input
                type="text"
                placeholder="Task title..."
                class="flex-1 bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-zinc-500 placeholder:text-zinc-500"
                name="title"
            >

            <textarea
                type="text"
                placeholder="Task Details..."
                class="flex-1 bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-zinc-500 placeholder:text-zinc-500"
                name="details"
            ></textarea>

            <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-500 px-5 py-3 rounded-lg font-medium transition"
            >
                Add Task
            </button>

        </form>


        <div class="flex flex-wrap gap-4">

           <% files.forEach(function(val){ %>
             <div class="bg-zinc-800 border border-zinc-700 rounded-lg p-5 w-64">

                <h2 class="text-lg font-medium mb-3">
                    <%= val %>
                </h2>

                <a
                    href= "/file/<%= val %>"
                    class="text-blue-400 text-sm hover:text-blue-300"
                >
                    Read more →
                </a>

            </div>
           <% }) %>


            

        </div>

    </div>

</body>
</html>
